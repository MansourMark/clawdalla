{
  "name": "clawdalla",
  "productName": "Clawdalla",
  "version": "1.0.0",
  "description": "A personal AI assistant with a chat side and a coding side, hosted on your own computer.",
  "author": "Clawdalla",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build:web": "vite build",
    "build:main": "esbuild electron/main.ts server/standalone.ts electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --entry-names=[name] --out-extension:.js=.cjs --external:electron --external:@playwright/mcp --log-level=warning && node scripts/copy-assets.mjs",
    "build": "npm run build:web && npm run build:main",
    "typecheck": "tsc --noEmit",
    "server": "npm run build && node dist/standalone.cjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "build": {
    "appId": "app.clawdalla.desktop",
    "productName": "Clawdalla",
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@playwright/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "Clawdalla-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Clawdalla"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.85"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/archiver": "^8.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "archiver": "^8.0.0",
    "dompurify": "^3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "web-push": "^4.0.0"
  }
}
